---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { FLAGS } from "../lib/settings";

interface Props {
  title: string;
  description: string;
  /** Load the Turnstile script (pages with a form). */
  turnstile?: boolean;
  noindex?: boolean;
  /** Hide the shared header and footer (admin). */
  bare?: boolean;
  ogTitle?: string;
}
const { title, description, turnstile = false, noindex = false, bare = false, ogTitle } = Astro.props;
// build.format "file" leaves the file name in pathname; canonical URLs must not carry it.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(path, Astro.site);
const settings = Astro.locals.settings;
const extras = FLAGS.some((f) => settings.flags[f]) ? { flags: settings.flags, promo: { ...settings.promo, image: settings.images.promo } } : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
<link rel="canonical" href={canonical.href}/>
<meta property="og:type" content="website"/>
<meta property="og:url" content={canonical.href}/>
<meta property="og:title" content={ogTitle ?? title}/>
<meta property="og:description" content={description}/>
<meta property="og:site_name" content="HowdyNET"/>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content={ogTitle ?? title}/>
<meta name="twitter:description" content={description}/>
<meta name="theme-color" content="#100500"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<slot name="head" />
{turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{!bare && <Nav />}
<main id="main">
  <slot />
</main>
{!bare && <Footer />}
{extras && (
  <>
    <script type="application/json" id="howdy-extras" set:html={JSON.stringify(extras)} />
    <script src="../scripts/extras.js"></script>
  </>
)}
</body>
</html>
