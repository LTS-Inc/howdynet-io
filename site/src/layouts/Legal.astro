---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  variant: "privacy" | "terms";
  heading: string;
  effective: string;
  updated: string;
}
const { title, description, variant, heading, effective, updated } = Astro.props;
---
<Base title={title} description={description}>
  <section class="hero hero--cream section--tight">
    <div class="container">
      <span class="eyebrow">Legal</span>
      <h1>{heading}</h1>
      <p class="muted" style="margin-top:12px;">Effective {effective} · Last updated {updated}</p>
      <nav class="legal-nav" aria-label="Legal pages" style="margin-top:20px;margin-bottom:0;">
        <a class="chip" href="/privacy" aria-current={variant === "privacy" ? "page" : undefined}>Privacy Policy</a>
        <a class="chip" href="/terms" aria-current={variant === "terms" ? "page" : undefined}>Terms of Service</a>
      </nav>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container">
      <div class="legal">
        <slot />
      </div>
    </div>
  </section>
</Base>
