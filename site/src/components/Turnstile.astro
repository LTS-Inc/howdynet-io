---
// Cloudflare Turnstile widget + honeypot. api.js is loaded by Base.astro when `turnstile` is set.
// Sitekey is public; it comes from PUBLIC_TURNSTILE_SITEKEY at build time.
interface Props { theme?: "light" | "dark" }
const { theme = "light" } = Astro.props;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? "1x00000000000000000000AA";
---
<div class="cf-turnstile" data-sitekey={sitekey} data-theme={theme} data-size="flexible"></div>
<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="visually-hidden" />
