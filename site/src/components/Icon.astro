const { name, size = 20, label, class: cls } = Astro.props;
---
<svg
  class:list={["icon", cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={paths[name]} />
</svg>
