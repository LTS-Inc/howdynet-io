<script is:inline>
/* ── LED WALL SIMULATION ── */
(function() {
  var sim = document.getElementById('led-sim');
  if (!sim) return;
  var colors = [
    '#E86A1A','#C85500','#1A9FE0','#0A6EBD',
    '#F5956A','#6EC6F0','#8B2200','#051830',
    '#facc15','#22c55e'
  ];
  var tiles = [];
  for (var r = 0; r < 5; r++) {
    for (var c = 0; c < 8; c++) {
      var tile = document.createElement('div');
      tile.className = 'av-led-tile';
      var color = colors[Math.floor(Math.random() * colors.length)];
      tile.style.background = color;
      tile.style.setProperty('--dur', (2 + Math.random() * 3).toFixed(1) + 's');
      tile.style.setProperty('--del', (Math.random() * 2).toFixed(1) + 's');
      sim.appendChild(tile);
      tiles.push({el: tile, colors: colors});
    }
  }
  // Slowly shift colors for living display effect
  setInterval(function() {
    var tile = tiles[Math.floor(Math.random() * tiles.length)];
    tile.el.style.background = colors[Math.floor(Math.random() * colors.length)];
  }, 400);
})();
</script>

<script is:inline>
/* ══ HOWDYNET FUN — floating hat, cursor trail, image flood, konami ══ */
window.addEventListener('load', function() {

  /* helpers */
  var COLORS = ['#E86A1A','#F5956A','#1A9FE0','#6EC6F0','#facc15','#C85500','#22c55e'];

  function showToast(msg) {
    var t = document.createElement('div');
    t.className = 'logo-toast';
    t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(function(){ requestAnimationFrame(function(){ t.classList.add('show'); }); });
    setTimeout(function(){ t.classList.remove('show'); setTimeout(function(){ t.remove(); }, 400); }, 2800);
  }

  function spawnConfetti(cx, cy, n) {
    for (var i = 0; i < n; i++) {
      (function(idx) {
        setTimeout(function() {
          var p = document.createElement('div');
          var angle = (idx / n) * Math.PI * 2;
          var dist  = 50 + Math.random() * 110;
          p.style.cssText = [
            'position:fixed','width:9px','height:9px','border-radius:2px',
            'pointer-events:none','z-index:9998',
            'left:' + cx + 'px', 'top:' + cy + 'px',
            'background:' + COLORS[idx % COLORS.length],
            'animation:confetti-fall 0.75s ease-out forwards'
          ].join(';');
          p.style.setProperty('--cx', (Math.cos(angle)*dist) + 'px');
          p.style.setProperty('--ch', (80 + Math.random()*140) + 'px');
          p.style.setProperty('--cr', ((Math.random()>.5?'':'-') + (180+Math.random()*360)) + 'deg');
          document.body.appendChild(p);
          setTimeout(function(){ p.remove(); }, 900);
        }, idx * 18);
      })(i);
    }
  }
  window.spawnConfetti = spawnConfetti;

  /* ── FLOATING HAT ── */
  var hat = document.getElementById('floating-hat');
  if (hat) {
    var ht = Math.random() * Math.PI * 2;
    var hClicks = 0;
    var isOrange = true;
    (function animHat() {
      ht += 0.007;
      var x = Math.max(60, Math.min(window.innerWidth  - 80, window.innerWidth  * 0.82 + 90 * Math.sin(ht)));
      var y = Math.max(80, Math.min(window.innerHeight - 90, window.innerHeight * 0.65 + 55 * Math.sin(2*ht)));
      hat.style.left = x + 'px';
      hat.style.top  = y + 'px';
      requestAnimationFrame(animHat);
    })();

    hat.addEventListener('click', function(e) {
      e.stopPropagation();
      spawnConfetti(e.clientX, e.clientY, 22);
      var idx = hClicks % 5;
      if (idx === 0 && window.rainHats) window.rainHats();
      else if (idx === 1) { isOrange=!isOrange; hat.textContent=isOrange?'🤠':'🎩'; showToast(isOrange?'Back to orange! 🟠':'Business casual mode 🎩'); }
      else if (idx === 2) showToast('One call. Every system. Zero excuses. 🤠');
      else if (idx === 3) { if (window.rainHats) window.rainHats(); spawnConfetti(e.clientX, e.clientY, 40); }
      else                showToast('No data caps. No ticket queues. No BS. 🤠');
      hClicks++;
    });
  }

  /* ── CURSOR SPARK TRAIL ── */
  var lastX=0, lastY=0, lastT=0, sIdx=0;
  document.addEventListener('mousemove', function(e) {
    var now = Date.now();
    var dx = e.clientX-lastX, dy = e.clientY-lastY;
    if (Math.sqrt(dx*dx+dy*dy) < 8 || now-lastT < 28) return;
    lastX=e.clientX; lastY=e.clientY; lastT=now;
    var sp = document.createElement('div');
    sp.style.cssText = [
      'position:fixed','width:8px','height:8px','border-radius:50%',
      'pointer-events:none','z-index:9997',
      'left:'+e.clientX+'px','top:'+e.clientY+'px',
      'background:'+COLORS[sIdx%COLORS.length],
      'animation:spark-fade 0.55s ease-out forwards'
    ].join(';');
    sp.style.setProperty('--sx', ((Math.random()-.5)*28)+'px');
    sp.style.setProperty('--sy', (Math.random()*16+4)+'px');
    document.body.appendChild(sp);
    setTimeout(function(){ sp.remove(); }, 620);
    sIdx++;
  });

  /* ── IMAGE FLOOD — click any embedded image 5x within 1.5s ── */
  var imgHits = {}, imgTimers = {};

  document.addEventListener('click', function(e) {
    var img = null;
    var tgt = e.target;
    /* direct image click */
    if (tgt.tagName === 'IMG' && tgt.src && tgt.src.indexOf('data:image') === 0) img = tgt;
    /* click on a div that wraps an embedded img (logo panels) */
    if (!img && tgt.closest) {
      var wrap = tgt.closest('.panel-logo-wrap, .panel-hat-wrap, .popup-flip-front, .popup-flip-back, .about-logo-wrap');
      if (wrap) { var found = wrap.querySelector('img[src^="data:image"]'); if (found) img = found; }
    }
    if (!img) return;

    var key = img.src.slice(0, 48);
    imgHits[key] = (imgHits[key] || 0) + 1;
    clearTimeout(imgTimers[key]);
    imgTimers[key] = setTimeout(function() { imgHits[key] = 0; }, 1500);

    spawnConfetti(e.clientX, e.clientY, 5);

    if (imgHits[key] >= 5) {
      imgHits[key] = 0;
      floodImage(img.src, e.clientX, e.clientY);
    }
  });

  function floodImage(src, cx, cy) {
    var wrap = document.createElement('div');
    wrap.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:9996;overflow:hidden;';
    document.body.appendChild(wrap);

    var total = 35, spawned = 0;
    var spawnDur = 2200;
    var interval = spawnDur / total;

    var ticker = setInterval(function() {
      if (spawned >= total) { clearInterval(ticker); setTimeout(function(){ wrap.remove(); }, 1500); return; }
      spawned++;

      var size  = 55 + Math.random() * 75;
      var startX = Math.random() * window.innerWidth;
      var color  = COLORS[spawned % COLORS.length];

      /* falling image */
      var el = document.createElement('img');
      el.src = src;
      el.style.cssText = [
        'position:absolute','width:'+size+'px','height:'+size+'px',
        'object-fit:contain','left:'+startX+'px','top:'+(-size-10)+'px',
        'border-radius:10px',
        'filter:drop-shadow(0 6px 18px rgba(0,0,0,0.45))',
        'will-change:transform'
      ].join(';');
      wrap.appendChild(el);

      /* physics */
      var px = startX, py = -(size+10);
      var vx = (Math.random()-.5)*3.5;
      var vy = 2.5 + Math.random()*4;
      var rot = (Math.random()-.5)*30;
      var rotV = (Math.random()-.5)*6;
      var bounces = 0;
      var alpha = 1;

      (function fall() {
        vy += 0.45; /* gravity */
        px += vx; py += vy;
        vx *= 0.995;
        rot += rotV;

        /* bounce */
        if (py + size >= window.innerHeight - 10) {
          py = window.innerHeight - size - 10;
          vy *= -0.38;
          rotV *= -0.5;
          bounces++;
          spawnConfetti(px + size/2, py + size, 4);
        }

        if (bounces >= 2) alpha -= 0.03;
        if (alpha <= 0) { el.remove(); return; }

        el.style.transform = 'translate('+( px-startX)+'px,'+py+'px) rotate('+rot+'deg)';
        el.style.opacity = alpha;

        /* color spark trail while falling */
        if (Math.random() < 0.35) {
          var sp2 = document.createElement('div');
          sp2.style.cssText = [
            'position:absolute','width:7px','height:7px','border-radius:50%',
            'left:'+(px+size/2-3.5)+'px','top:'+(py+size*0.3)+'px',
            'background:'+color,'pointer-events:none',
            'animation:spark-fade 0.5s ease-out forwards'
          ].join(';');
          sp2.style.setProperty('--sx', ((Math.random()-.5)*18)+'px');
          sp2.style.setProperty('--sy', (Math.random()*14+3)+'px');
          wrap.appendChild(sp2);
          setTimeout(function(){ sp2.remove(); }, 560);
        }

        requestAnimationFrame(fall);
      })();
    }, interval);

    showToast('🤠 Yeehaw! Everything under one hat!');
  }

  /* ── KONAMI CODE → COWBOY MODE ── */
  var KS = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  var kp = 0, kt = null;
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeKonami(); return; }
    if (e.key === KS[kp]) {
      kp++;
      clearTimeout(kt);
      kt = setTimeout(function(){ kp=0; }, 2000);
      if (kp === KS.length) { kp=0; launchKonami(); }
    } else {
      kp = (e.key === KS[0]) ? 1 : 0;
    }
  });

  function launchKonami() {
    var ov = document.getElementById('konami-overlay');
    if (ov) ov.classList.add('show');
    if (window.rainHats) window.rainHats();
    for (var i=0; i<5; i++) {
      (function(ii){
        setTimeout(function(){
          var tw = document.createElement('div');
          tw.className = 'tumbleweed';
          tw.textContent = '🌵';
          tw.style.top = (15+Math.random()*65)+'vh';
          tw.style.animationDuration = (3+Math.random()*2.5)+'s';
          tw.style.animationDelay = (ii*0.4)+'s';
          document.body.appendChild(tw);
          setTimeout(function(){ tw.remove(); }, 9000);
        }, ii*500);
      })(i);
    }
  }

}); /* end load */

function closeKonami() {
  var el = document.getElementById('konami-overlay');
  if (el) el.classList.remove('show');
}
</script>

<script is:inline>
/* ── STICKY BAR ── */
(function() {
  var bar = document.getElementById('sticky-bar');
  if (!bar) return;
  var dismissed = sessionStorage.getItem('barDismissed');
  if (dismissed) return;
  var shown = false;
  window.addEventListener('scroll', function() {
    if (shown) return;
    if (window.scrollY > 400) {
      shown = true;
      bar.classList.add('visible');
    }
  }, {passive: true});
})();
function dismissBar() {
  var bar = document.getElementById('sticky-bar');
  if (bar) { bar.classList.remove('visible'); sessionStorage.setItem('barDismissed','1'); }
}
</script>

<script is:inline>
/* ── NAV DROPDOWN — hover + click for all environments ── */
(function() {
  document.querySelectorAll('.nav-dropdown').forEach(function(dd) {
    var menu = dd.querySelector('.nav-dropdown-menu');
    var toggle = dd.querySelector('.nav-dropdown-toggle');
    if (!menu) return;
    var open = false;
    var timer;

    function showMenu() {
      clearTimeout(timer);
      open = true;
      menu.style.visibility = 'visible';
      menu.style.opacity = '1';
      menu.style.transform = 'translateX(-50%) translateY(0)';
      menu.style.pointerEvents = 'all';
      if (toggle) toggle.style.color = 'rgba(255,255,255,0.9)';
    }
    function hideMenu(delay) {
      timer = setTimeout(function() {
        open = false;
        menu.style.visibility = 'hidden';
        menu.style.opacity = '0';
        menu.style.transform = 'translateX(-50%) translateY(-4px)';
        menu.style.pointerEvents = 'none';
        if (toggle) toggle.style.color = '';
      }, delay || 0);
    }

    /* hover */
    dd.addEventListener('mouseenter', function() { showMenu(); });
    dd.addEventListener('mouseleave', function() { hideMenu(120); });

    /* click toggle — works in sandboxed previews too */
    if (toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (open) { hideMenu(0); } else { showMenu(); }
      });
    }

    /* close when clicking a menu item */
    menu.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', function() { hideMenu(0); });
    });
  });

  /* close dropdown when clicking outside */
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-dropdown')) {
      document.querySelectorAll('.nav-dropdown-menu').forEach(function(m) {
        m.style.visibility = 'hidden';
        m.style.opacity = '0';
        m.style.pointerEvents = 'none';
      });
    }
  });
})();
</script>

<script is:inline>
/* ── COOKIE BANNER ── */
(function() {
  var KEY = 'howdynet_cookie_consent';
  var banner = document.getElementById('howdy-cookie-banner');
  var btnA = document.getElementById('cb-accept');
  var btnD = document.getElementById('cb-decline');
  function setCookie(n,v,d){ var e=new Date(); e.setTime(e.getTime()+(d*864e5)); document.cookie=n+'='+v+';expires='+e.toUTCString()+';path=/;SameSite=Lax'; }
  function getCookie(n){ var r=new RegExp('(?:^|; )'+n+'=([^;]*)'); var m=document.cookie.match(r); return m?m[1]:null; }
  if (!getCookie(KEY)) { setTimeout(function(){ banner.classList.add('cb-visible'); }, 1400); }
  btnA.addEventListener('click', function(){ setCookie(KEY,'accepted',365); banner.classList.remove('cb-visible'); });
  btnD.addEventListener('click', function(){ setCookie(KEY,'declined',180); banner.classList.remove('cb-visible'); });
})();
</script>
