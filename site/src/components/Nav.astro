---
import Icon from "./Icon.astro";
const links = [
  ["/internet", "Internet"],
  ["/managed-it", "Managed IT & LAN"],
  ["/plans", "Plans"],
  ["/ranchhand", "RanchHand"],
  ["/network-test", "Network test"],
  ["/about", "About"],
] as const;
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "").replace(/\/$/, "") || "/";
const { announcement } = Astro.locals.settings;
---
<header class="site-header">
  {announcement.enabled && announcement.text && (
    <div class="announce">
      {announcement.text}
      {announcement.href && announcement.linkText && <> <a href={announcement.href}>{announcement.linkText}</a></>}
    </div>
  )}
  <nav class="site-nav container" aria-label="Primary" id="site-nav">
    <a class="brand" href="/">Howdy<span>NET</span></a>
    <ul class="nav-links" id="nav-links">
      {links.map(([href, label]) => (
        <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>
      ))}
    </ul>
    <a class="btn btn-primary btn-sm nav-cta" href="/about#contact">Talk to us</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
      <Icon name="menu" size={24} class="icon-menu" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </nav>
</header>
<script>
  const nav = document.getElementById("site-nav")!;
  const btn = nav.querySelector<HTMLButtonElement>(".nav-toggle")!;
  btn.addEventListener("click", () => {
    const open = nav.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(open));
  });
  nav.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      nav.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    }
  });
</script>
