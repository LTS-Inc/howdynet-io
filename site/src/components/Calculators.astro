---
---
<div class="grid-2" id="calculators">
  <div class="calc">
    <span class="eyebrow">Vendor chaos calculator</span>
    <h3>What juggling vendors costs you</h3>
    <div class="slider">
      <label for="vc-count">Vendors you manage <output id="vc-count-val">5</output></label>
      <input type="range" id="vc-count" min="1" max="15" value="5" />
    </div>
    <div class="slider">
      <label for="vc-hours">Hours a month on tech issues <output id="vc-hours-val">8 hrs</output></label>
      <input type="range" id="vc-hours" min="1" max="40" value="8" />
    </div>
    <div class="slider">
      <label for="vc-rate">Your hourly value <output id="vc-rate-val">$75/hr</output></label>
      <input type="range" id="vc-rate" min="25" max="300" step="5" value="75" />
    </div>
    <div class="result"><b id="vc-result">$0</b><span>a year in your time, not counting the bills</span></div>
    <p class="insight" id="vc-insight" aria-live="polite"></p>
  </div>
  <div class="calc">
    <span class="eyebrow">Downtime calculator</span>
    <h3>What an outage costs you</h3>
    <div class="slider">
      <label for="dt-industry">Industry</label>
      <select id="dt-industry">
        <option value="500">Restaurant or hospitality</option>
        <option value="800">Retail</option>
        <option value="1200" selected>Professional services</option>
        <option value="2500">Manufacturing</option>
        <option value="4000">Healthcare</option>
        <option value="1500">Other</option>
      </select>
    </div>
    <div class="slider">
      <label for="dt-emp">Employees affected <output id="dt-emp-val">10</output></label>
      <input type="range" id="dt-emp" min="1" max="200" value="10" />
    </div>
    <div class="slider">
      <label for="dt-hrs">Outage hours a year <output id="dt-hrs-val">12 hrs</output></label>
      <input type="range" id="dt-hrs" min="1" max="100" value="12" />
    </div>
    <div class="result"><b id="dt-result">$0</b><span>a year, at <span id="dt-per-hour">$0/hr</span> of downtime</span></div>
    <p class="insight" id="dt-insight" aria-live="polite"></p>
  </div>
</div>
<script src="../scripts/calculators.js"></script>
