---
import { Image } from "astro:assets";
import hatBlue from "../assets/hat-blue.png";
---
<!-- ── INTERNET — Blue ── -->
<section class="internet" id="internet">
  <div class="internet-inner">
    <div>
      <div class="internet-logo-wrap">
        <div class="internet-logo-glow"></div>
        <Image src={hatBlue} width={512} class="internet-logo" alt="HowdyNET Internet Services" />
      </div>
      <div class="stag-b">🔵 Blue Hat — Your WAN</div>
      <h2 class="sh-b">Your connection<br/>to the <em>world.</em></h2>
      <p class="sb-b">The big ISPs will sell you a number, bury you in a support queue, and blame your router when things go wrong. We're a licensed ISP that manages your connection end-to-end — and when something breaks at 2am, a real human who knows your setup answers the phone.</p>
      <a href="#contact" class="btn-panel btn-blue" style="max-width:240px">Get Internet Services →</a>
    </div>
    <div class="icards">
      <div class="icard">
        <svg class="icard-icon" viewBox="0 0 24 24" fill="none" stroke="#1A9FE0" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <div><h3>Business Internet Services</h3><p>Local internet done right — we're small enough to care, big enough to matter. Managed from day one through every outage.</p></div>
      </div>
      <div class="icard">
        <svg class="icard-icon" viewBox="0 0 24 24" fill="none" stroke="#1A9FE0" stroke-width="2.5" stroke-linecap="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <div><h3>Fiber & Ethernet Cabling</h3><p>Clean, labeled, professional runs. Trust the cables and their labels. Done right the first time.</p></div>
      </div>
      <div class="icard">
        <svg class="icard-icon" viewBox="0 0 24 24" fill="none" stroke="#1A9FE0" stroke-width="2.5" stroke-linecap="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        <div><h3>ISP & Vendor Coordination</h3><p>We deal with the telecoms so you don't have to. One call to us handles everything.</p></div>
      </div>
      <div class="icard">
        <svg class="icard-icon" viewBox="0 0 24 24" fill="none" stroke="#1A9FE0" stroke-width="2.5" stroke-linecap="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <div><h3>Hardware, Software & Custom Dev</h3><p>Right-sized equipment and custom software for your actual needs. No markup games, no overselling.</p></div>
      </div>

      <!-- Network topology diagram -->
      <div class="ph-img" style="margin-top:8px;">
        <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg">
          <rect width="800" height="400" fill="#051830"/>
          <g opacity="0.04" stroke="#1A9FE0"><line x1="0" y1="80" x2="800" y2="80"/><line x1="0" y1="160" x2="800" y2="160"/><line x1="0" y1="240" x2="800" y2="240"/><line x1="0" y1="320" x2="800" y2="320"/><line x1="160" y1="0" x2="160" y2="400"/><line x1="320" y1="0" x2="320" y2="400"/><line x1="480" y1="0" x2="480" y2="400"/><line x1="640" y1="0" x2="640" y2="400"/></g>
          <g transform="translate(110,70)"><line x1="0" y1="30" x2="0" y2="180" stroke="#1A9FE0" stroke-width="3"/><line x1="-18" y1="180" x2="18" y2="180" stroke="#1A9FE0" stroke-width="3"/><circle cx="0" cy="20" r="7" fill="none" stroke="#1A9FE0" stroke-width="2"/><path d="M-14,6 Q0,-8 14,6" fill="none" stroke="#1A9FE0" stroke-width="1.5"/><path d="M-22,-2 Q0,-20 22,-2" fill="none" stroke="#1A9FE0" stroke-width="1" opacity="0.5"/><text x="0" y="205" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.3)" font-family="sans-serif">WISP Tower</text></g>
          <path d="M150,120 Q240,90 330,150" fill="none" stroke="#1A9FE0" stroke-width="1.5" stroke-dasharray="5,4" opacity="0.3"/><text x="240" y="100" text-anchor="middle" font-size="9" fill="#1A9FE0" opacity="0.4" font-family="sans-serif">Wireless</text>
          <g transform="translate(400,115)"><rect x="-50" y="-28" width="100" height="56" rx="8" fill="rgba(26,159,224,0.12)" stroke="#1A9FE0" stroke-width="2"/><rect x="-35" y="-14" width="70" height="5" rx="2" fill="#1A9FE0" opacity="0.5"/><rect x="-35" y="-3" width="70" height="5" rx="2" fill="#1A9FE0" opacity="0.35"/><rect x="-35" y="8" width="70" height="5" rx="2" fill="#1A9FE0" opacity="0.25"/><circle cx="28" cy="-12" r="3" fill="#22c55e"/><circle cx="28" cy="-1" r="3" fill="#22c55e"/><text x="0" y="48" text-anchor="middle" font-size="11" fill="#1A9FE0" font-weight="700" font-family="sans-serif">HowdyNET Gateway</text><text x="0" y="62" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.2)" font-family="sans-serif">RanchHand Managed</text></g>
          <g stroke="#E86A1A" stroke-width="1.5" opacity="0.35"><line x1="450" y1="120" x2="580" y2="75"/><line x1="450" y1="120" x2="580" y2="155"/><line x1="450" y1="130" x2="580" y2="235"/><line x1="450" y1="130" x2="580" y2="315"/></g>
          <g transform="translate(640,60)"><rect x="-40" y="-18" width="80" height="36" rx="4" fill="rgba(232,106,26,0.1)" stroke="#E86A1A" stroke-width="1.5"/><text x="0" y="5" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.4)" font-family="sans-serif">Wi-Fi APs</text><text x="0" y="32" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.2)" font-family="sans-serif">Coverage everywhere</text></g>
          <g transform="translate(640,142)"><rect x="-40" y="-18" width="80" height="36" rx="4" fill="rgba(232,106,26,0.1)" stroke="#E86A1A" stroke-width="1.5"/><text x="0" y="5" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.4)" font-family="sans-serif">Cameras</text><text x="0" y="32" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.2)" font-family="sans-serif">24/7 monitored</text></g>
          <g transform="translate(640,222)"><rect x="-40" y="-18" width="80" height="36" rx="4" fill="rgba(232,106,26,0.1)" stroke="#E86A1A" stroke-width="1.5"/><text x="0" y="5" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.4)" font-family="sans-serif">POS / Work</text><text x="0" y="32" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.2)" font-family="sans-serif">Priority traffic</text></g>
          <g transform="translate(640,302)"><rect x="-40" y="-18" width="80" height="36" rx="4" fill="rgba(232,106,26,0.1)" stroke="#E86A1A" stroke-width="1.5"/><text x="0" y="5" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.4)" font-family="sans-serif">LED Displays</text><text x="0" y="32" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.2)" font-family="sans-serif">Remotely managed</text></g>
          <text x="250" y="380" text-anchor="middle" font-size="9" fill="#1A9FE0" opacity="0.3" font-family="sans-serif">WAN — Your Connection</text>
          <text x="580" y="380" text-anchor="middle" font-size="9" fill="#E86A1A" opacity="0.3" font-family="sans-serif">LAN — Your Business</text>
        </svg>
      </div>
    </div>
  </div>
</section>
