---
import { Image } from "astro:assets";
import hatOrange from "../assets/hat-orange.png";
---
<!-- ── LAN — Orange ── -->
<section class="lan" id="lan">
  <div class="lan-inner">
    <div>
      <div class="lan-logo-wrap">
        <div class="lan-logo-glow"></div>
        <Image src={hatOrange} width={512} class="lan-logo" alt="HowdyNET LAN Solutions" />
      </div>
      <div class="stag-o">🟠 Orange Hat — Your LAN</div>
      <h2 class="sh-o">Everything inside<br/>your <em>four walls.</em></h2>
      <p class="sb-o">Once the internet's in, we make sure everything inside your space runs flawlessly — Wi-Fi, cameras, AV, IT support, and every piece of gear your team depends on.</p>
      <a href="#contact" class="btn-panel btn-orange" style="max-width:240px;background:var(--flame);color:#fff;box-shadow:0 4px 20px rgba(0,0,0,0.2)">Get LAN Solutions →</a>

      <!-- Hardware procurement callout -->
      <div style="margin-top:28px;background:var(--burnt);border:1px solid rgba(232,106,26,0.3);border-radius:12px;padding:22px 24px;max-width:400px;box-shadow:0 4px 20px rgba(139,34,0,0.15);">
        <div style="font-size:0.62rem;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:var(--light-o);margin-bottom:8px;">🏷️ Procurement Pricing Perk</div>
        <div style="font-size:1rem;font-weight:900;color:var(--cream);margin-bottom:8px;line-height:1.25;">We buy hardware at cost.<br/>Our MSP clients pay the same.</div>
        <div style="font-size:0.78rem;color:rgba(253,246,238,0.65);line-height:1.7;font-weight:400;">Most IT companies mark up hardware 20–40%. We don't. Every switch, AP, camera, and server is passed to you at our procurement price — no games, no margin stacking.</div>
      </div>

      <!-- RanchHand callout -->
      <div style="margin-top:16px;background:#8B2200;border:1px solid rgba(232,106,26,0.35);border-radius:12px;padding:20px 22px;max-width:400px;box-shadow:0 4px 20px rgba(139,34,0,0.2);">
        <div style="font-size:0.62rem;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;color:#F5956A;margin-bottom:8px;">📡 Not In Our ISP Area Yet?</div>
        <div style="font-size:0.95rem;font-weight:900;color:#FDF6EE;margin-bottom:6px;line-height:1.3;">RanchHand™ upgrades<br/>what you already have.</div>
        <div style="font-size:0.78rem;color:rgba(253,246,238,0.7);line-height:1.65;font-weight:400;margin-bottom:14px;">Keep your existing ISP. Our managed HowdyNET Gateway eliminates bufferbloat, blocks ads and unwanted content, secures your network with behavioral fingerprinting, and gives your team VPN access from anywhere — even camping under the stars.</div>
        <a href="#ranchhand" style="font-family:'Nunito',sans-serif;font-size:0.8rem;font-weight:800;color:#E86A1A;text-decoration:none;display:inline-flex;align-items:center;gap:6px;" onmouseover="this.style.color='#F5956A'" onmouseout="this.style.color='#E86A1A'">Learn about RanchHand →</a>
      </div>
      <!-- Service visual -->
      <div style="margin-top:32px;border-radius:12px;overflow:hidden;">
        
      </div>
    </div>
    <div class="lan-grid">
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7"/><path d="M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14"/></svg>
        <h3>Wi-Fi Design & Engineering</h3>
        <p>No dead zones. No excuses. Coverage designed for your actual space.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        <h3>Security Cameras & Access Control</h3>
        <p>Enterprise-grade managed systems — installed, monitored, and supported.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <h3>Managed IT & Help Desk</h3>
        <p>24/7 monitoring and a real human to call when something breaks.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><path d="M9 19V6l12-3v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        <h3>Audio / Video Installations</h3>
        <p>Conference rooms, lobbies, restaurants — AV that makes an impression.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <h3>AI & Business Automation</h3>
        <p>We build the automations that eliminate your most repetitive work — from client intake to reporting to system orchestration.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <h3>Vendor Consolidation</h3>
        <p>Fewer vendors, lower costs, less confusion — and more done.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M2 10h20"/></svg>
        <h3>Large LED & Display Walls</h3>
        <p>From lobby screens to full video walls — installed, calibrated, and remotely managed. Menu boards, digital signage, and branded displays that actually work reliably.</p>
      </div>
      <div class="lcard">
        <svg class="lcard-icon" viewBox="0 0 24 24" fill="none" stroke="#C85500" stroke-width="2.5" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
        <h3>Custom Business Apps</h3>
        <p>Your entire operation at your fingertips — cameras, access control, network status, and support, all in one white-labeled app built for your business. One interface. Everything HowdyNET manages.</p>
      </div>
    </div>
  </div>
</section>
