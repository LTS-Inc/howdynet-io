---
const { contact } = Astro.locals.settings;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">Howdy<span>NET</span></a>
        <p style="margin-top:12px;max-width:360px;">One partner for business internet, managed networks and IT. Licensed WISP. Hardware at our cost. A person answers.</p>
        <p style="margin-top:12px;">{contact.hq} · {contact.area}</p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/internet">Business internet</a></li>
          <li><a href="/managed-it">Managed IT &amp; LAN</a></li>
          <li><a href="/ranchhand">RanchHand gateway</a></li>
          <li><a href="/plans">Plans &amp; pricing</a></li>
        </ul>
      </div>
      <div>
        <h4>Tools</h4>
        <ul>
          <li><a href="/network-test">Network quality test</a></li>
          <li><a href="/plans#calculators">Value calculators</a></li>
          <li><a href="/about#coverage">Coverage check</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/about#contact">Contact</a></li>
          <li><a href={`tel:${contact.phone.replace(/\D/g, "")}`}>{contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} HowdyNET. All rights reserved. Part of <a href="https://longoriatechnologysolutions.co" rel="noopener">LTS</a>.</span>
      <span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · We do not sell your data.</span>
    </div>
  </div>
</footer>
