    <div style="margin-top:28px;padding:24px 28px;background:rgba(232,106,26,0.07);border:1px solid rgba(232,106,26,0.2);border-radius:14px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
