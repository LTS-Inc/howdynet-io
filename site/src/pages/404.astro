---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · HowdyNET" description="That page wandered off the ranch.">
  <div style="min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;background:var(--cream);">
    <div style="font-size:4rem;">🤠</div>
    <h1 style="font-size:2rem;font-weight:900;margin:12px 0 8px;">Well, shoot. That page isn't here.</h1>
    <p style="color:rgba(16,5,0,0.6);max-width:420px;">The link may be old or mistyped. Head back home and we'll get you where you need to go.</p>
    <a href="/" style="margin-top:22px;font-weight:800;background:var(--flame);color:#fff;padding:12px 24px;border-radius:8px;text-decoration:none;">Back to HowdyNET →</a>
  </div>
</Base>
