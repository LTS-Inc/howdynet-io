---
import Base from "../layouts/Base.astro";
export const prerender = true;
---
<Base title="Page not found · HowdyNET" description="That page wandered off the ranch." noindex>
  <section class="notfound">
    <div>
      <img class="hat" src="/img/hat-orange-320.webp" width="160" height="160" alt="" />
      <h1>Well, shoot. That page isn't here.</h1>
      <p class="lede" style="max-width:420px;margin:12px auto 0;">The link may be old or mistyped. Head back home and we'll get you where you need to go.</p>
      <div class="row" style="justify-content:center;margin-top:24px;">
        <a class="btn btn-primary" href="/">Back to HowdyNET</a>
        <a class="btn btn-ghost" href="/about#contact">Talk to us</a>
      </div>
    </div>
  </section>
</Base>
