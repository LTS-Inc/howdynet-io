{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howdynet-www",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // workers.dev stays on for previews; `howdy site` deploys a routes-less copy of this
  // config there before `howdy cutover` binds the custom domain.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "www.howdynet.io", "custom_domain": true }],
  "send_email": [
    { "name": "EMAIL", "destination_address": "support@howdynet.io" }
  ],
  "kv_namespaces": [
    // `howdy site` creates the namespace and writes its id here; commit the result.
    { "binding": "FORM_SUBMISSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true }
}
