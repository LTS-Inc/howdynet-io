{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howdynet-www",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // This is the SOURCE config. `astro build` resolves it into dist/server/wrangler.json, which is
  // what every deploy uses (`wrangler deploy -c dist/server/wrangler.json`). `howdy site` deploys
  // a routes-less copy of that generated file to workers.dev before `howdy cutover` binds the domain.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "www.howdynet.io", "custom_domain": true }],
  "send_email": [
    { "name": "EMAIL", "destination_address": "support@howdynet.io" }
  ],
  "kv_namespaces": [
    // `howdy site` creates the namespace and writes its id here; commit the result.
    { "binding": "FORM_SUBMISSIONS", "id": "2d6d6c3b8bb64fd4b154e2a78d65a6dd" }
  ],
  "observability": { "enabled": true }
}
