{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howdynet-www",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages render on the Worker. Without this, browser navigations to a path that is not a
    // static file would get the asset 404 page instead of reaching the Worker. The excluded paths
    // are static files and the legacy URLs that public/_redirects answers.
    "run_worker_first": ["/*", "!/_astro/*", "!/img/*", "!/favicon.svg", "!/robots.txt", "!/sitemap-*.xml", "!/sitemap-index.xml", "!/coverage", "!/coverage.html", "!/privacy.html", "!/terms.html", "!/index.html"]
  },
  // This is the SOURCE config. `astro build` resolves it into dist/server/wrangler.json, which is
  // what every deploy uses (`wrangler deploy -c dist/server/wrangler.json`). `howdy site` deploys
  // a routes-less copy of that generated file to workers.dev before `howdy cutover` binds the domain.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "www.howdynet.io", "custom_domain": true }],
  "send_email": [
    { "name": "EMAIL", "destination_address": "support@howdynet.io" }
  ],
  "kv_namespaces": [
    // `howdy site` creates the namespace and writes its id here; commit the result.
    { "binding": "FORM_SUBMISSIONS", "id": "2d6d6c3b8bb64fd4b154e2a78d65a6dd" }
  ],
  "observability": { "enabled": true }
}
